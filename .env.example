# TripSpree Production App Configuration
NEXT_PUBLIC_APP_URL=https://tripspree-prod.vercel.app

# Vapi Voice Assistant (Client-side Web SDK)
# Obtain from Vapi Dashboard (vapi.ai) -> API Keys -> Public Key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Voice Orchestrator Service URL (Deploy to Railway, Render, Fly.io, or VPS)
NEXT_PUBLIC_VOICE_ORCHESTRATOR_URL=https://voice.tripspree.com

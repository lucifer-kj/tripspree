# Voice Orchestrator Environment Variables
PORT=3001

# Vapi Webhook Secret (HMAC-SHA256 signature verification)
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# Vapi Private Server API Key (Server-side management/control only)
VAPI_API_KEY=your_vapi_private_api_key_here

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Redis Fast Session Store (Warning counters, ephemeral call state)
REDIS_URL=redis://localhost:6379
